# Public origin used by canonical URLs, sitemap.xml and structured data.
SITE_URL=https://www.example.com

# Use :80 before DNS is ready; use the domain after DNS points to this server.
SITE_ADDRESS=:80

# Local development path. Docker overrides this with /app/data/bluefin.db.
DATABASE_PATH=./data/bluefin.db

# Protects /operations and /api/operations with HTTP Basic authentication.
OPERATIONS_ADMIN_EMAIL=owner@example.com
OPERATIONS_ADMIN_PASSWORD=replace-with-a-long-random-password
